# ──────────────────────────────────────────────
# ExamVault Environment Variables
# Copy to .env and fill in values
# NEVER commit the .env file!
# ──────────────────────────────────────────────

# ── Database ──
DATABASE_URL=postgresql://examvault:examvault_dev_password@localhost:5432/examvault?schema=public
POSTGRES_USER=examvault
POSTGRES_PASSWORD=examvault_dev_password
POSTGRES_DB=examvault

# ── API Server ──
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Session / Auth ──
SESSION_SECRET=replace-with-64-char-random-hex-string-for-dev-only
SESSION_MAX_AGE_MS=900000
# 15 minutes idle timeout

# ── Encryption ──
# 256-bit master key as 64 hex characters (dev only — use Vault/KMS in production)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MASTER_KEY_ID=local-dev-key-001

# ── Audit Signing ──
# Ed25519 private key, base64-encoded (generate with: node -e "const {generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))")
AUDIT_SIGNING_PRIVATE_KEY=replace-with-base64-ed25519-private-key
AUDIT_SIGNING_PUBLIC_KEY=replace-with-base64-ed25519-public-key

# ── MinIO (S3-compatible object storage) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=examvault_minio
MINIO_SECRET_KEY=examvault_minio_secret
MINIO_BUCKET=examvault-images
MINIO_USE_SSL=false

# ── Seed Admin ──
SEED_ADMIN_EMAIL=admin@examvault.local
SEED_ADMIN_PASSWORD=Admin@ExamVault2024!

# ── Rate Limiting ──
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5

# ── Frontend ──
VITE_API_URL=http://localhost:3001
