// ExamVault Prisma Schema
// All question content and answer keys are stored encrypted (AES-256-GCM envelope encryption)
// The audit_events table is append-only (enforced by database triggers)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Users ──────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EXAMINER
  REVIEWER
  AUDITOR
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String    @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          Role      @default(EXAMINER)
  mfaSecret     String?   @map("mfa_secret") @db.VarChar(255) // encrypted TOTP secret
  mfaEnabled    Boolean   @default(false) @map("mfa_enabled")
  loginAttempts Int       @default(0) @map("login_attempts")
  lockedUntil   DateTime? @map("locked_until")
  mustSetupMfa  Boolean   @default(true) @map("must_setup_mfa")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  questions        Question[]
  questionVersions QuestionVersion[]
  auditEvents      AuditEvent[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  csrfToken  String   @map("csrf_token") @db.VarChar(128)
  mfaVerified Boolean @default(false) @map("mfa_verified")
  expiresAt  DateTime @map("expires_at")
  lastActive DateTime @default(now()) @map("last_active")
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ── Syllabus ───────────────────────────────────────────────────────

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subjects Subject[]

  @@map("exams")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @db.VarChar(10) // e.g., PHY, CHE, MAT
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  // Human-readable ID sequence for this subject
  nextSeq   Int       @default(1) @map("next_seq")

  @@unique([examId, code])
  @@map("subjects")
}

model Topic {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics Subtopic[]
  questions Question[]

  @@map("topics")
}

model Subtopic {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("subtopics")
}

// ── Questions ──────────────────────────────────────────────────────

enum QuestionStatusEnum {
  DRAFT
  SUBMITTED
  WITHDRAWN
  UNDER_REVIEW // TODO: Step 2 — review workflow
  APPROVED     // TODO: Step 2 — review workflow
  REJECTED     // TODO: Step 2 — review workflow
  RETIRED      // TODO: Step 2 — review workflow

  @@map("question_status")
}

enum QuestionTypeEnum {
  MCQ_SINGLE
  MCQ_MULTI
  INTEGER

  @@map("question_type")
}

enum CognitiveLevelEnum {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE

  @@map("cognitive_level")
}

enum LanguageEnum {
  EN
  HI
  BILINGUAL

  @@map("language")
}

model Question {
  id             String           @id @default(uuid()) @db.Uuid
  humanId        String           @unique @map("human_id") @db.VarChar(20) // EV-PHY-000123
  authorId       String           @map("author_id") @db.Uuid
  subjectId      String           @map("subject_id") @db.Uuid
  topicId        String?          @map("topic_id") @db.Uuid
  subtopicId     String?          @map("subtopic_id") @db.Uuid
  type           QuestionTypeEnum
  difficulty     Float            @default(0.5)
  cognitiveLevel CognitiveLevelEnum @map("cognitive_level")
  marks          Float            @default(1)
  negativeMarks  Float            @default(0) @map("negative_marks")
  estimatedTime  Int              @default(120) @map("estimated_time") // seconds
  language       LanguageEnum     @default(EN)
  currentVersion Int              @default(1) @map("current_version")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  author   User     @relation(fields: [authorId], references: [id])
  subject  Subject  @relation(fields: [subjectId], references: [id])
  topic    Topic?   @relation(fields: [topicId], references: [id])
  subtopic Subtopic? @relation(fields: [subtopicId], references: [id])

  versions QuestionVersion[]

  @@index([authorId])
  @@index([subjectId])
  @@index([type])
  @@index([humanId])
  @@map("questions")
}

model QuestionVersion {
  id                 String             @id @default(uuid()) @db.Uuid
  questionId         String             @map("question_id") @db.Uuid
  versionNo          Int                @map("version_no")
  status             QuestionStatusEnum @default(DRAFT)
  authorId           String             @map("author_id") @db.Uuid

  // Encrypted content (AES-256-GCM envelope encryption)
  encryptedContent   Bytes              @map("encrypted_content")    // ciphertext of QuestionContent
  contentNonce       Bytes              @map("content_nonce")        // 96-bit GCM nonce
  contentTag         Bytes              @map("content_tag")          // 128-bit GCM auth tag
  encryptedContentKey Bytes             @map("encrypted_content_key") // data key wrapped by master key

  // Encrypted answer key (separate envelope)
  encryptedAnswer    Bytes              @map("encrypted_answer")
  answerNonce        Bytes              @map("answer_nonce")
  answerTag          Bytes              @map("answer_tag")
  encryptedAnswerKey Bytes              @map("encrypted_answer_key")

  // Integrity
  contentCommitment  String             @map("content_commitment") @db.VarChar(128) // SHA-256(salt + canonical JSON)
  keyId              String             @map("key_id") @db.VarChar(64)              // for key rotation tracking

  createdAt          DateTime           @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@unique([questionId, versionNo])
  @@index([questionId])
  @@index([status])
  @@map("question_versions")
}

// ── Audit Log ──────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  timestamp  DateTime @default(now())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.VarChar(255)
  metadata   Json?    @db.JsonB
  prevHash   String   @map("prev_hash") @db.VarChar(128) // hex-encoded SHA-256
  entryHash  String   @map("entry_hash") @db.VarChar(128)
  signature  String   @db.VarChar(256) // base64-encoded Ed25519 signature

  actor User? @relation(fields: [actorId], references: [id])

  @@index([timestamp])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_events")
}
