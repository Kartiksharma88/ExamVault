// ExamVault Prisma Schema
// All question content and answer keys are stored encrypted (AES-256-GCM envelope encryption)
// The audit_events and approvals tables are append-only (enforced by database triggers)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EXAMINER
  REVIEWER
  AUDITOR
  MODERATOR
  CUSTODIAN
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String    @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          Role      @default(EXAMINER)
  mfaSecret     String?   @map("mfa_secret") @db.VarChar(255) // encrypted TOTP secret
  mfaEnabled    Boolean   @default(false) @map("mfa_enabled")
  loginAttempts Int       @default(0) @map("login_attempts")
  lockedUntil   DateTime? @map("locked_until")
  mustSetupMfa  Boolean   @default(true) @map("must_setup_mfa")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions             Session[]
  questions            Question[]
  questionVersions     QuestionVersion[]
  auditEvents          AuditEvent[]
  userSubjectExpertise UserSubjectExpertise[]
  signingKey           UserSigningKey?
  conflictDeclarations ConflictDeclaration[]
  proposedPolicies     ApprovalPolicy[]        @relation("ProposedPolicies")
  approvedPolicies     ApprovalPolicy[]        @relation("ApprovedPolicies")
  reviewAssignments    ReviewAssignment[]
  reviews              Review[]
  approvals            Approval[]
  duplicateDispositions DuplicateDisposition[]
  corpusSources        CorpusSource[]
  notifications        Notification[]
  retiredVersions      QuestionVersion[]       @relation("RetiredBy")
  createdBlueprints    ExamBlueprint[]         @relation("CreatedBlueprints")
  proposedBlueprints   BlueprintVersion[]      @relation("ProposedBlueprints")
  approvedBlueprints   BlueprintVersion[]      @relation("ApprovedBlueprints")
  custodianMemberships CustodianGroupMember[]
  proposedGenerations  GenerationRequest[]     @relation("ProposedGenerations")
  generationApprovals  GenerationApproval[]
  downloadTokens       DownloadToken[]
  keyShares            KeyShareRecord[]
  shareSubmissions     ShareSubmission[]

  @@map("users")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  csrfToken   String   @map("csrf_token") @db.VarChar(128)
  mfaVerified Boolean  @default(false) @map("mfa_verified")
  expiresAt   DateTime @map("expires_at")
  lastActive  DateTime @default(now()) @map("last_active")
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserSubjectExpertise {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("user_subject_expertise")
}

model UserSigningKey {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  publicKey         String   @map("public_key") @db.VarChar(256)
  wrappedPrivateKey Bytes    @map("wrapped_private_key")
  keyId             String   @map("key_id") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_signing_keys")
}

model ConflictDeclaration {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  conflictType         String   @map("conflict_type") @db.VarChar(64)
  encryptedDescription Bytes    @map("encrypted_description")
  descriptionNonce     Bytes    @map("description_nonce")
  descriptionTag       Bytes    @map("description_tag")
  wrappedKey           Bytes    @map("wrapped_key")
  keyId                String   @map("key_id") @db.VarChar(64)
  conflictHash         String   @map("conflict_hash") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conflictHash])
  @@map("conflict_declarations")
}

// ── Syllabus ───────────────────────────────────────────────────────

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subjects Subject[]
  policies ApprovalPolicy[]
  blueprints ExamBlueprint[]
  generationRequests GenerationRequest[]
  papers Paper[]

  @@map("exams")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @db.VarChar(10) // e.g., PHY, CHE, MAT
  isActive  Boolean  @default(true) @map("is_active")
  nextSeq   Int      @default(1) @map("next_seq")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exam                 Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics               Topic[]
  questions            Question[]
  userSubjectExpertise UserSubjectExpertise[]
  policies             ApprovalPolicy[]

  @@unique([examId, code])
  @@map("subjects")
}

model Topic {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics Subtopic[]
  questions Question[]

  @@map("topics")
}

model Subtopic {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("subtopics")
}

// ── Questions ──────────────────────────────────────────────────────

enum QuestionStatusEnum {
  DRAFT
  SUBMITTED
  SCREENING
  DUPLICATE_FLAGGED
  READY_FOR_REVIEW
  UNDER_REVIEW
  CHANGES_REQUESTED
  MODERATION
  APPROVED
  REJECTED
  WITHDRAWN
  RETIRED

  @@map("question_status")
}

enum QuestionTypeEnum {
  MCQ_SINGLE
  MCQ_MULTI
  INTEGER

  @@map("question_type")
}

enum CognitiveLevelEnum {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE

  @@map("cognitive_level")
}

enum LanguageEnum {
  EN
  HI
  BILINGUAL

  @@map("language")
}

model Question {
  id             String             @id @default(uuid()) @db.Uuid
  humanId        String             @unique @map("human_id") @db.VarChar(20) // EV-PHY-000123
  authorId       String             @map("author_id") @db.Uuid
  subjectId      String             @map("subject_id") @db.Uuid
  topicId        String?            @map("topic_id") @db.Uuid
  subtopicId     String?            @map("subtopic_id") @db.Uuid
  type           QuestionTypeEnum
  difficulty     Float              @default(0.5)
  cognitiveLevel CognitiveLevelEnum @map("cognitive_level")
  marks          Float              @default(1)
  negativeMarks  Float              @default(0) @map("negative_marks")
  estimatedTime  Int                @default(120) @map("estimated_time") // seconds
  language       LanguageEnum       @default(EN)
  currentVersion Int                @default(1) @map("current_version")
  isLocked       Boolean            @default(false) @map("is_locked")
  lockReason     String?            @map("lock_reason") @db.Text
  lockedAt       DateTime?          @map("locked_at")
  lockedById     String?            @map("locked_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  subject  Subject   @relation(fields: [subjectId], references: [id])
  topic    Topic?    @relation(fields: [topicId], references: [id])
  subtopic Subtopic? @relation(fields: [subtopicId], references: [id])

  versions  QuestionVersion[]
  approvals Approval[]

  @@index([authorId])
  @@index([subjectId])
  @@index([type])
  @@index([humanId])
  @@map("questions")
}

model QuestionVersion {
  id                  String             @id @default(uuid()) @db.Uuid
  questionId          String             @map("question_id") @db.Uuid
  versionNo           Int                @map("version_no")
  status              QuestionStatusEnum @default(DRAFT)
  authorId            String             @map("author_id") @db.Uuid

  // Encrypted content (AES-256-GCM envelope encryption)
  encryptedContent    Bytes              @map("encrypted_content")
  contentNonce        Bytes              @map("content_nonce")
  contentTag          Bytes              @map("content_tag")
  encryptedContentKey Bytes              @map("encrypted_content_key")

  // Encrypted answer key (separate envelope)
  encryptedAnswer     Bytes              @map("encrypted_answer")
  answerNonce         Bytes              @map("answer_nonce")
  answerTag           Bytes              @map("answer_tag")
  encryptedAnswerKey  Bytes              @map("encrypted_answer_key")

  // Integrity
  contentCommitment   String             @map("content_commitment") @db.VarChar(128)
  keyId               String             @map("key_id") @db.VarChar(64)
  ciphertextSha256       String?            @map("ciphertext_sha256") @db.VarChar(64)
  answerCiphertextSha256 String?            @map("answer_ciphertext_sha256") @db.VarChar(64)

  // Step 2 versioning additions
  parentVersionId            String?            @map("parent_version_id") @db.Uuid
  changeJustification        String?            @map("change_justification") @db.Text
  policyVersion              Int?               @map("policy_version")
  supersededAt               DateTime?          @map("superseded_at")
  retirementReason           String?            @map("retirement_reason") @db.VarChar(64)
  retiredById                String?            @map("retired_by_id") @db.Uuid

  // Difficulty Derivation & Conflict Resolution
  finalDifficulty            Float?             @map("final_difficulty")
  finalTimeSeconds           Int?               @map("final_time_seconds")
  difficultySource           String?            @default("EXPERT_RATING") @map("difficulty_source") @db.VarChar(32)
  difficultyDerivationMethod String?            @map("difficulty_derivation_method") @db.VarChar(64)
  difficultySetById          String?            @map("difficulty_set_by_id") @db.Uuid
  difficultyConflictFlag     Boolean            @default(false) @map("difficulty_conflict_flag")
  difficultyConflictResolved Boolean            @default(false) @map("difficulty_conflict_resolved")
  difficultyResolutionNote   String?            @map("difficulty_resolution_note") @db.Text
  encryptedDiffJustification Bytes?             @map("encrypted_diff_justification")
  diffJustificationNonce     Bytes?             @map("diff_justification_nonce")
  diffJustificationTag       Bytes?             @map("diff_justification_tag")
  diffJustificationKey       Bytes?             @map("diff_justification_key")

  createdAt           DateTime           @default(now()) @map("created_at")

  question             Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author               User                  @relation(fields: [authorId], references: [id])
  parentVersion        QuestionVersion?      @relation("VersionHierarchy", fields: [parentVersionId], references: [id])
  childVersions        QuestionVersion[]     @relation("VersionHierarchy")
  retiredBy            User?                 @relation("RetiredBy", fields: [retiredById], references: [id])
  originalityReport    OriginalityReport?
  duplicateDisposition DuplicateDisposition?
  reviewRounds         ReviewRound[]
  reviews              Review[]
  reviewAssignments    ReviewAssignment[]
  approvals            Approval[]
  exclusionGroups      QuestionExclusionGroup[]

  @@unique([questionId, versionNo])
  @@index([questionId])
  @@index([status])
  @@index([parentVersionId])
  @@map("question_versions")
}

// ── Approval Policies ──────────────────────────────────────────────

model ApprovalPolicy {
  id                         String            @id @default(uuid()) @db.Uuid
  examId                     String?           @map("exam_id") @db.Uuid
  subjectId                  String?           @map("subject_id") @db.Uuid
  questionType               QuestionTypeEnum? @map("question_type")
  version                    Int               @default(1)
  requiredReviewers          Int               @default(2) @map("required_reviewers")
  requireBlindSolve          Boolean           @default(true) @map("require_blind_solve")
  requireModerator           Boolean           @default(true) @map("require_moderator")
  requireLanguageReview      Boolean           @default(true) @map("require_language_review")
  maxReviewDays              Int               @default(7) @map("max_review_days")
  difficultyTolerance        Float             @default(20) @map("difficulty_tolerance")
  exactMatchThreshold        Float             @default(1.0) @map("exact_match_threshold")
  highSimilarityThreshold    Float             @default(0.85) @map("high_similarity_threshold")
  mediumSimilarityThreshold  Float             @default(0.60) @map("medium_similarity_threshold")
  effectiveFrom              DateTime          @default(now()) @map("effective_from")
  proposedById               String            @map("proposed_by_id") @db.Uuid
  approvedById               String?           @map("approved_by_id") @db.Uuid
  isActive                   Boolean           @default(false) @map("is_active")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  proposedBy   User          @relation("ProposedPolicies", fields: [proposedById], references: [id])
  approvedBy   User?         @relation("ApprovedPolicies", fields: [approvedById], references: [id])
  exam         Exam?         @relation(fields: [examId], references: [id])
  subject      Subject?      @relation(fields: [subjectId], references: [id])
  reviewRounds ReviewRound[]

  @@index([subjectId])
  @@index([isActive])
  @@map("approval_policies")
}

// ── Review Rounds and Assignments ──────────────────────────────────

model ReviewRound {
  id                String   @id @default(uuid()) @db.Uuid
  questionVersionId String   @map("question_version_id") @db.Uuid
  roundNumber       Int      @default(1) @map("round_number")
  policyVersion     Int      @default(1) @map("policy_version")
  policyId          String?  @map("policy_id") @db.Uuid
  status            String   @default("ACTIVE") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at")

  questionVersion QuestionVersion    @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  policy          ApprovalPolicy?    @relation(fields: [policyId], references: [id])
  assignments     ReviewAssignment[]

  @@index([questionVersionId])
  @@map("review_rounds")
}

model ReviewAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  roundId            String   @map("round_id") @db.Uuid
  questionVersionId  String   @map("question_version_id") @db.Uuid
  reviewerId         String   @map("reviewer_id") @db.Uuid
  assignedRole       String   @default("REVIEWER") @map("assigned_role") @db.VarChar(20)
  status             String   @default("PENDING") @db.VarChar(32)
  dueDate            DateTime @map("due_date")
  selectionSeed      String   @map("selection_seed") @db.VarChar(64)
  eligibleCount      Int      @map("eligible_count")
  reassignedToId     String?  @map("reassigned_to_id") @db.Uuid
  reassignedById     String?  @map("reassigned_by_id") @db.Uuid
  reassignmentReason String?  @map("reassignment_reason") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  round           ReviewRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  reviewer        User            @relation(fields: [reviewerId], references: [id])
  review          Review?

  @@unique([roundId, reviewerId])
  @@index([reviewerId])
  @@index([status])
  @@map("review_assignments")
}

model Review {
  id                         String    @id @default(uuid()) @db.Uuid
  assignmentId               String    @unique @map("assignment_id") @db.Uuid
  questionVersionId          String    @map("question_version_id") @db.Uuid
  reviewerId                 String    @map("reviewer_id") @db.Uuid
  phase                      String    @default("SOLVE") @db.VarChar(20)
  contentCommitment          String    @map("content_commitment") @db.VarChar(128)
  encryptedBlindAnswer       Bytes?    @map("encrypted_blind_answer")
  blindAnswerNonce           Bytes?    @map("blind_answer_nonce")
  blindAnswerTag             Bytes?    @map("blind_answer_tag")
  encryptedSolveKey          Bytes?    @map("encrypted_solve_key")
  timeTakenSeconds           Int?      @map("time_taken_seconds")
  difficultyRating           Float?    @map("difficulty_rating")
  blindAnswerMatchesKey      Boolean?  @map("blind_answer_matches_key")
  disagreementFlag           Boolean   @default(false) @map("disagreement_flag")
  disagreementResolved       Boolean   @default(false) @map("disagreement_resolved")
  disagreementResolutionNote String?   @map("disagreement_resolution_note") @db.Text
  checklist                  Json?
  decision                   String?   @db.VarChar(32)
  encryptedComments          Bytes?    @map("encrypted_comments")
  commentsNonce              Bytes?    @map("comments_nonce")
  commentsTag                Bytes?    @map("comments_tag")
  encryptedCommentsKey       Bytes?    @map("encrypted_comments_key")
  keyId                      String?   @map("key_id") @db.VarChar(64)
  submittedAt                DateTime? @map("submitted_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  assignment      ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionVersion QuestionVersion  @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  reviewer        User             @relation(fields: [reviewerId], references: [id])

  @@index([questionVersionId])
  @@index([reviewerId])
  @@map("reviews")
}

// ── Approvals (Append-Only) ────────────────────────────────────────

model Approval {
  id                String   @id @default(uuid()) @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  versionNo         Int      @map("version_no")
  contentCommitment String   @map("content_commitment") @db.VarChar(128)
  decision          String   @db.VarChar(32)
  role              String   @db.VarChar(32) // REVIEWER or MODERATOR
  approverId        String   @map("approver_id") @db.Uuid
  reviewRound       Int      @default(1) @map("review_round")
  policyVersion     Int      @default(1) @map("policy_version")
  timestamp         DateTime @default(now())
  signature         String   @db.VarChar(256)

  approver User            @relation(fields: [approverId], references: [id])
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version  QuestionVersion @relation(fields: [questionId, versionNo], references: [questionId, versionNo], onDelete: Cascade)

  @@index([questionId, versionNo])
  @@index([approverId])
  @@map("approvals")
}

// ── Originality Check ──────────────────────────────────────────────

model OriginalityReport {
  id                String   @id @default(uuid()) @db.Uuid
  questionVersionId String   @unique @map("question_version_id") @db.Uuid
  riskLevel         String   @map("risk_level") @db.VarChar(20)
  highestScore      Float    @default(0) @map("highest_score")
  checkedAt         DateTime @default(now()) @map("checked_at")
  serviceVersion    String   @default("1.0.0") @map("service_version") @db.VarChar(32)
  metadata          Json?

  questionVersion QuestionVersion    @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  matches         OriginalityMatch[]

  @@map("originality_reports")
}

model OriginalityMatch {
  id                       String   @id @default(uuid()) @db.Uuid
  reportId                 String   @map("report_id") @db.Uuid
  sourceType               String   @map("source_type") @db.VarChar(20)
  sourceReference          String   @map("source_reference") @db.VarChar(255)
  matchedQuestionVersionId String?  @map("matched_question_version_id") @db.Uuid
  matchedDocumentId        String?  @map("matched_document_id") @db.Uuid
  overallScore             Float    @map("overall_score")
  exactHashMatch           Boolean  @default(false) @map("exact_hash_match")
  minhashScore             Float    @default(0) @map("minhash_score")
  tfidfScore               Float    @default(0) @map("tfidf_score")
  semanticScore            Float?   @map("semantic_score")
  stemScore                Float    @default(0) @map("stem_score")
  optionsScore             Float    @default(0) @map("options_score")
  optionsReorderedMatch    Boolean  @default(false) @map("options_reordered_match")
  matchedSpans             Json?    @map("matched_spans")
  sourceTextSnippet        String?  @map("source_text_snippet") @db.Text
  createdAt                DateTime @default(now()) @map("created_at")

  report OriginalityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("originality_matches")
}

model DuplicateDisposition {
  id                        String   @id @default(uuid()) @db.Uuid
  questionVersionId         String   @unique @map("question_version_id") @db.Uuid
  disposition               String   @db.VarChar(32)
  moderatorId               String   @map("moderator_id") @db.Uuid
  encryptedJustification    Bytes    @map("encrypted_justification")
  justificationNonce        Bytes    @map("justification_nonce")
  justificationTag          Bytes    @map("justification_tag")
  encryptedJustificationKey Bytes    @map("encrypted_justification_key")
  keyId                     String   @map("key_id") @db.VarChar(64)
  dispositionedAt           DateTime @default(now()) @map("dispositioned_at")

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  moderator       User            @relation(fields: [moderatorId], references: [id])

  @@map("duplicate_dispositions")
}

// ── Corpus for Reference Matching ──────────────────────────────────

model CorpusSource {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  type         String   @db.VarChar(32)
  licenseNote  String?  @map("license_note") @db.Text
  importedById String   @map("imported_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  importedBy User             @relation(fields: [importedById], references: [id])
  documents  CorpusDocument[]

  @@map("corpus_sources")
}

model CorpusDocument {
  id                String   @id @default(uuid()) @db.Uuid
  sourceId          String   @map("source_id") @db.Uuid
  title             String   @db.VarChar(255)
  identifier        String   @db.VarChar(100)
  plaintextContent  String   @map("plaintext_content") @db.Text
  normalizedContent String   @map("normalized_content") @db.Text
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  source CorpusSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([identifier])
  @@map("corpus_documents")
}

// ── Notifications ──────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(64)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ── State Machine Transition Rules ─────────────────────────────────

model ValidStateTransition {
  fromStatus String @map("from_status") @db.VarChar(32)
  toStatus   String @map("to_status") @db.VarChar(32)

  @@id([fromStatus, toStatus])
  @@map("valid_state_transitions")
}

// ── Audit Log & Tamper-Evident Registration (Step 3) ──────────────────

model AuditEvent {
  id                String   @id @default(uuid()) @db.Uuid
  timestamp         DateTime @default(now())
  schemaVersion     String   @default("1.0.0") @map("schema_version") @db.VarChar(16)
  actorId           String?  @map("actor_id") @db.Uuid
  actorPseudonym    String?  @map("actor_pseudonym") @db.VarChar(64)
  action            String   @db.VarChar(64)
  targetType        String   @map("target_type") @db.VarChar(64)
  targetId          String?  @map("target_id") @db.VarChar(255)
  versionNo         Int?     @map("version_no")
  payloadHash       String?  @map("payload_hash") @db.VarChar(64)
  contentCommitment String?  @map("content_commitment") @db.VarChar(128)
  approvalSignature String?  @map("approval_signature") @db.VarChar(512)
  metadataHash      String?  @map("metadata_hash") @db.VarChar(64)
  metadata          Json?    @db.JsonB
  prevHash          String   @map("prev_hash") @db.VarChar(128)
  entryHash         String   @map("entry_hash") @db.VarChar(128)
  signature         String   @db.VarChar(512)

  actor   User?         @relation(fields: [actorId], references: [id])
  outboxes AuditOutbox[]

  @@index([timestamp])
  @@index([actorId])
  @@index([actorPseudonym])
  @@index([action])
  @@index([targetType, targetId])
  @@index([entryHash])
  @@map("audit_events")
}

model AuditOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  sinkType      String    @map("sink_type") @db.VarChar(32) // FABRIC, etc.
  status        String    @default("PENDING") @db.VarChar(32) // PENDING, COMMITTED, FAILED
  payload       Json      @db.JsonB
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(5) @map("max_retries")
  lastError     String?   @map("last_error") @db.Text
  nextRetryAt   DateTime? @map("next_retry_at")
  committedAt   DateTime? @map("committed_at")
  fabricTxId    String?   @map("fabric_tx_id") @db.VarChar(128)
  fabricBlockNo BigInt?   @map("fabric_block_no")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event AuditEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([eventId])
  @@index([sinkType])
  @@map("audit_outbox")
}

model MerkleCheckpoint {
  id               String   @id @default(uuid()) @db.Uuid
  rootHash         String   @map("root_hash") @db.VarChar(64)
  rangeStart       Int      @map("range_start")
  rangeEnd         Int      @map("range_end")
  eventCount       Int      @map("event_count")
  treeSize         Int      @map("tree_size")
  signature        String   @db.VarChar(512) // ExamBody Ed25519 signature
  witnessSignature String?  @map("witness_signature") @db.VarChar(512)
  witnessReceipt   Json?    @map("witness_receipt") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([rangeStart, rangeEnd])
  @@index([rootHash])
  @@map("merkle_checkpoints")
}

model StorageIntegrityScan {
  id               String   @id @default(uuid()) @db.Uuid
  scannedAt        DateTime @default(now()) @map("scanned_at")
  totalObjects     Int      @map("total_objects")
  validObjects     Int      @map("valid_objects")
  corruptedObjects Int      @map("corrupted_objects")
  missingObjects   Int      @map("missing_objects")
  orphanedObjects  Int      @map("orphaned_objects")
  details          Json?    @db.JsonB
  auditEventId     String?  @map("audit_event_id") @db.Uuid

  @@index([scannedAt])
  @@map("storage_integrity_scans")
}

model PlainAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  timestamp   DateTime @default(now())
  eventType   String   @map("event_type") @db.VarChar(64)
  subjectType String   @map("subject_type") @db.VarChar(64)
  subjectId   String   @map("subject_id") @db.VarChar(255)
  payload     Json?    @db.JsonB

  @@index([timestamp])
  @@index([eventType])
  @@map("plain_audit_logs")
}

// ── Step 4 & 5: Paper Generation, Blueprints, Custodians & Threshold Release ──

model ExamBlueprint {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id") @db.Uuid

  exam        Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("CreatedBlueprints", fields: [createdById], references: [id])
  versions    BlueprintVersion[]

  @@index([examId])
  @@map("exam_blueprints")
}

model BlueprintVersion {
  id                String    @id @default(uuid()) @db.Uuid
  blueprintId       String    @map("blueprint_id") @db.Uuid
  versionNo         Int       @map("version_no")
  content           Json      @db.JsonB
  versionHash       String    @map("version_hash") @db.VarChar(64)
  isApproved        Boolean   @default(false) @map("is_approved")
  proposerId        String    @map("proposer_id") @db.Uuid
  approverId        String?   @map("approver_id") @db.Uuid
  approvalSignature String?   @map("approval_signature") @db.VarChar(512)
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  blueprint          ExamBlueprint       @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  proposer           User                @relation("ProposedBlueprints", fields: [proposerId], references: [id])
  approver           User?               @relation("ApprovedBlueprints", fields: [approverId], references: [id])
  generationRequests GenerationRequest[]
  papers             Paper[]

  @@unique([blueprintId, versionNo])
  @@index([versionHash])
  @@map("blueprint_versions")
}

model CustodianGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  n           Int
  k           Int
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  members            CustodianGroupMember[]
  generationRequests GenerationRequest[]

  @@map("custodian_groups")
}

model CustodianGroupMember {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  custodianId String   @map("custodian_id") @db.Uuid
  publicKey   String   @map("public_key") @db.VarChar(128)
  fingerprint String   @map("fingerprint") @db.VarChar(64)
  enrolledAt  DateTime @default(now()) @map("enrolled_at")

  group     CustodianGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  custodian User           @relation(fields: [custodianId], references: [id])

  @@unique([groupId, custodianId])
  @@index([custodianId])
  @@map("custodian_group_members")
}

model GenerationRequest {
  id                       String   @id @default(uuid()) @db.Uuid
  examId                   String   @map("exam_id") @db.Uuid
  blueprintVersionId       String   @map("blueprint_version_id") @db.Uuid
  custodianGroupId         String   @map("custodian_group_id") @db.Uuid
  proposerId               String   @map("proposer_id") @db.Uuid
  status                   String   @default("REQUESTED") @db.VarChar(32)
  setsCount                Int      @default(1) @map("sets_count")
  exportProfile            String   @default("GENERIC_CSV") @map("export_profile") @db.VarChar(64)
  generateNotBefore        DateTime @map("generate_not_before")
  generateNotAfter         DateTime @map("generate_not_after")
  releaseNotBefore         DateTime @map("release_not_before")
  answerKeyNotBefore       DateTime @map("answer_key_not_before")
  downloadRetentionMinutes Int      @default(720) @map("download_retention_minutes")
  requestHash              String   @map("request_hash") @db.VarChar(64)
  rejectionReason          String?  @map("rejection_reason") @db.Text
  createdAt                DateTime @default(now()) @map("created_at")

  exam             Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  blueprintVersion BlueprintVersion     @relation(fields: [blueprintVersionId], references: [id])
  custodianGroup   CustodianGroup       @relation(fields: [custodianGroupId], references: [id])
  proposer         User                 @relation("ProposedGenerations", fields: [proposerId], references: [id])
  approvals        GenerationApproval[]
  paper            Paper?

  @@index([examId])
  @@index([status])
  @@map("generation_requests")
}

model GenerationApproval {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  approverId  String   @map("approver_id") @db.Uuid
  requestHash String   @map("request_hash") @db.VarChar(64)
  signature   String   @db.VarChar(512)
  timestamp   DateTime @default(now())

  request  GenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User              @relation(fields: [approverId], references: [id])

  @@unique([requestId, approverId])
  @@index([requestId])
  @@map("generation_approvals")
}

model Paper {
  id                 String    @id @default(uuid()) @db.Uuid
  examId             String    @map("exam_id") @db.Uuid
  requestId          String    @unique @map("request_id") @db.Uuid
  blueprintVersionId String    @map("blueprint_version_id") @db.Uuid
  setsCount          Int       @default(1) @map("sets_count")
  status             String    @default("GENERATING") @db.VarChar(32)
  paperHash          String?   @map("paper_hash") @db.VarChar(64)
  seedCommit         String?   @map("seed_commit") @db.VarChar(64)
  revealedSeed       String?   @map("revealed_seed") @db.VarChar(128)
  revealedSalt       String?   @map("revealed_salt") @db.VarChar(64)
  publicManifest     Json?     @map("public_manifest") @db.JsonB
  validationSummary  Json?     @map("validation_summary") @db.JsonB
  failureReason      String?   @map("failure_reason") @db.Text
  releasedAt         DateTime? @map("released_at")
  wipedAt            DateTime? @map("wiped_at")
  answerKeyReleasedAt DateTime? @map("answer_key_released_at")
  closedAt           DateTime? @map("closed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  exam             Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  request          GenerationRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  blueprintVersion BlueprintVersion      @relation(fields: [blueprintVersionId], references: [id])
  artifacts        PaperArtifact[]
  keyShares        KeyShareRecord[]
  shareSubmissions ShareSubmission[]
  reservations     QuestionReservation[]
  downloadTokens   DownloadToken[]

  @@index([examId])
  @@index([status])
  @@map("papers")
}

model PaperArtifact {
  id                 String   @id @default(uuid()) @db.Uuid
  paperId            String   @map("paper_id") @db.Uuid
  artifactType       String   @map("artifact_type") @db.VarChar(32)
  ciphertextLocation String   @map("ciphertext_location") @db.VarChar(512)
  ciphertextSha256   String   @map("ciphertext_sha256") @db.VarChar(64)
  keyCommitment      String   @map("key_commitment") @db.VarChar(64)
  nonce              Bytes    @map("nonce")
  formatVersion      String   @default("v1") @map("format_version") @db.VarChar(16)
  createdAt          DateTime @default(now()) @map("created_at")

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, artifactType])
  @@map("paper_artifacts")
}

model KeyShareRecord {
  id              String   @id @default(uuid()) @db.Uuid
  paperId         String   @map("paper_id") @db.Uuid
  artifactType    String   @map("artifact_type") @db.VarChar(32)
  shareIndex      Int      @map("share_index")
  custodianId     String   @map("custodian_id") @db.Uuid
  sealedShare     String   @map("sealed_share") @db.Text
  shareCommitment String   @map("share_commitment") @db.VarChar(64)
  salt            String   @map("salt") @db.VarChar(64)
  status          String   @default("SEALED") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at")

  paper     Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  custodian User  @relation(fields: [custodianId], references: [id])

  @@unique([paperId, artifactType, custodianId])
  @@map("key_share_records")
}

model ShareSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  paperId         String   @map("paper_id") @db.Uuid
  custodianId     String   @map("custodian_id") @db.Uuid
  artifactType    String   @map("artifact_type") @db.VarChar(32)
  shareIndex      Int      @map("share_index")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  status          String   @default("ACCEPTED") @db.VarChar(32)
  rejectionReason String?  @map("rejection_reason") @db.VarChar(64)

  paper     Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  custodian User  @relation(fields: [custodianId], references: [id])

  @@index([paperId, artifactType])
  @@map("share_submissions")
}

model QuestionReservation {
  id                String   @id @default(uuid()) @db.Uuid
  paperId           String   @map("paper_id") @db.Uuid
  reservationHandle String   @map("reservation_handle") @db.VarChar(64)
  reservedAt        DateTime @default(now()) @map("reserved_at")

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, reservationHandle])
  @@index([reservationHandle])
  @@map("question_reservations")
}

model DownloadToken {
  id            String   @id @default(uuid()) @db.Uuid
  token         String   @unique @db.VarChar(64)
  paperId       String   @map("paper_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fileType      String   @map("file_type") @db.VarChar(32)
  remainingUses Int      @default(5) @map("remaining_uses")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([paperId, userId])
  @@map("download_tokens")
}

model QuestionExclusionGroup {
  id                String   @id @default(uuid()) @db.Uuid
  questionVersionId String   @unique @map("question_version_id") @db.Uuid
  groupId           String   @map("group_id") @db.VarChar(64)
  source            String   @map("source") @db.VarChar(32)
  templateFamilyId  String?  @map("template_family_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("question_exclusion_groups")
}


