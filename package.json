{
  "name": "examvault",
  "version": "0.1.0",
  "private": true,
  "description": "Secure examination paper generation framework",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @examvault/web run test:e2e",
    "db:migrate": "pnpm --filter @examvault/api run db:migrate",
    "db:seed": "pnpm --filter @examvault/api run db:seed",
    "db:generate": "pnpm --filter @examvault/api run db:generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "experiment:tamper": "tsx scripts/experiments/tamper-matrix.ts",
    "experiment:perf": "tsx scripts/experiments/performance-bench.ts",
    "experiment:failure": "tsx scripts/experiments/failure-injection.ts",
    "experiment:ops": "tsx scripts/experiments/operational-complexity.ts",
    "experiment:all": "tsx scripts/experiments/tamper-matrix.ts && tsx scripts/experiments/performance-bench.ts && tsx scripts/experiments/failure-injection.ts && tsx scripts/experiments/operational-complexity.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
